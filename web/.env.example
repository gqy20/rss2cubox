# API Data Source: "ic" or "local"
API_SOURCE=local

# IC API (used when API_SOURCE=ic)
IC_API_URL=http://ic.nexus.tashan.ac.cn/api/v1/articles/batch
IC_SOURCE_TYPE=gqy

# Local PostgreSQL (used when API_SOURCE=local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/rss2cubox

# API Base URL for server-side rendering
NEXT_PUBLIC_API_BASE_URL=http://localhost:3424

# Server-only credential for background TED generation; no frontend key screen
TED_WRITE_TOKEN=

# Server-only maintainer credential for /api/suggest-source GET and POST (32+ characters)
# Unset disables this API. Never use a NEXT_PUBLIC_ variable for this credential.
SOURCE_SUGGEST_TOKEN=
