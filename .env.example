# rss2cubox 配置模板
#
# 用法：cp .env.example .env，然后填下面标 [必填] 的项。
# .env 已被 .gitignore 覆盖，不会进版本库；本文件不要写入任何真实密钥。
#
# ────────────────────────────────────────────────────────────
# 这个模板**故意只列必填项和常调项**。全部 103 个配置项（名字、类型、默认值、
# 说明、分组）的唯一声明处是 src/rss2cubox/config.py 的注册表：
#
#     make config                 列出全部，标出哪些被覆盖
#     make config-help            同上，并显示每项的说明
#     make config CONFIG_ARGS="--overridden-only"    只看被覆盖的
#     make config CONFIG_ARGS="--group policy"       只看某一组
#
# 原则：**.env 里不要写等于默认值的行**，那是噪音。要改默认值就改 config.py。
# tests/test_config_registry.py 会强制注册表与代码里的默认值一致，防止漂移。
#
# ⚠️ 优先级：.env **覆盖**已存在的系统环境变量（runner 无条件赋值，各 agent 模块
#    用 load_dotenv(override=True)）。所以临时改配置请改 .env，在终端 export 无效。
# ────────────────────────────────────────────────────────────

# === LLM 网关 ===
# [必填] 走 Authorization: Bearer。**不要再同时设 ANTHROPIC_API_KEY** ——
# 两个都设会让每个请求同时带上 X-Api-Key 和 Authorization 两个凭据头。
ANTHROPIC_AUTH_TOKEN=
# [必填] 网关地址。官方 Anthropic 用 https://api.anthropic.com
ANTHROPIC_BASE_URL=
# [必填] 模型 ID，必须与网关 /v1/models 返回的 id 完全一致（大小写敏感）
ANTHROPIC_MODEL=

# === 存储 ===
# make db 会起专用容器 rss2cubox-pg（postgres:17-alpine，宿主端口 5434）
LOCAL_DB_URL=postgresql://postgres:postgres@localhost:5434/rss2cubox

# === IC 文章库 ===
# [必填] 批量导入端点，也是本地库为空时的去重基线回退来源
IC_API_URL=
# 本地调试建议 false：跑完不真正推送到 IC
IC_PUSH_ENABLED=false

# === 规模与成本（最常调的一项）===
# 单轮最多 enrich + 入库多少篇，直接决定耗时和花费。
# 实测：1500 篇 ≈ 5.2 小时、真实成本 ¥14.3（CLI 记账 $324，高估 166 倍）。
# 第一次跑建议先设 50 试水。
MAX_ITEMS_PER_RUN=50

# ────────────────────────────────────────────────────────────
# 以下是"调过之后才需要写进来"的项，默认值都能正常跑，所以这里不预填。
# 需要时用 `make config-help` 查名字和说明，再按需加到 .env。
#
# 几个容易踩的：
#   FEED_READ_TIMEOUT_SECONDS   默认 30，**不要调小**——/juejin/* 这类抓取型路由
#                               在健康实例上实测就要 19~28s
#   FEED_FETCH_CONCURRENCY      默认 10，**不要调大**——部分超时是我们自己的并发
#                               打在公共实例上造成的限流
#   FULLTEXT_ITEM_TIMEOUT_S     默认 30 时 L2 只有 15s 预算，openai.com 这类站点
#                               会全线超时；调到 60 后 L2 得 20s
#   FULLTEXT_MAX_WORKERS        默认 10，每个 URL 都会 chromium.launch() 一次，
#                               实测降到 5 后成功率与吞吐都上升
#   ENRICH_MAX_BUDGET_USD       是**单篇**上限，不是整轮总量，拦不住总花费
#   MAX_ITEMS_PER_SOURCE        默认 60。设 0 会让单个高产源吃光整轮预算
#   FEED_SECTIONS_DISABLE       停用整类源（twitter / bilibili / werss / default），
#                               比删 feeds.txt 里的行更好，修好后删 token 即可恢复
#   SIGNAL_CLUSTER_MAX_ARTICLES 默认 200。全字段投影下 200 篇 ≈ 337K tokens，
#                               已超过模型 200K 上下文窗口
#
# 政策链路的 17 个 POLICY_* 开关同理，见 `make config CONFIG_ARGS="--group policy"`。
# ────────────────────────────────────────────────────────────
