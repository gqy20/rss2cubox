# rss2cubox 环境变量模板
#
# 用法：cp .env.example .env，然后填下面标 [必填] 的项。
# .env 已被 .gitignore 覆盖，不会进版本库；本文件不要写入任何真实密钥。
#
# ⚠️ 优先级：.env **覆盖**已存在的系统环境变量。
#    runner.py 的 _load_local_env_file() 是无条件赋值，各 agent 模块用
#    load_dotenv(override=True)。所以临时改配置请改 .env，在 shell 里 export 无效。

# === LLM 网关（Claude Agent SDK）===
# [必填] 走 Authorization: Bearer。不要再同时设 ANTHROPIC_API_KEY ——
# 那会让每个请求同时带上 X-Api-Key 和 Authorization 两个凭据头。
ANTHROPIC_AUTH_TOKEN=
# [必填] 网关地址。官方 Anthropic 用 https://api.anthropic.com
ANTHROPIC_BASE_URL=
# [必填] 模型 ID，必须与网关 /v1/models 返回的 id 完全一致（大小写敏感）
ANTHROPIC_MODEL=

# === 存储 ===
# 本地 PostgreSQL。make db 会起专用容器 rss2cubox-pg（postgres:17-alpine，宿主端口 5434）
LOCAL_DB_URL=postgresql://postgres:postgres@localhost:5434/rss2cubox
# 仅 global_insights 历史链路需要；留空则相关功能跳过
NEON_DATABASE_URL=
NEON_PUSH_ENABLED=false

# === IC 文章库 ===
# [必填] 批量导入端点，也是主流程的去重基线来源
IC_API_URL=http://ic.nexus.tashan.ac.cn/api/v1/articles/batch
IC_SOURCE_TYPE=gqy
# 本地调试建议 false：跑完不真正推送到 IC
IC_PUSH_ENABLED=false

# === 调度上限 ===
# enrich + 入库共用的单次总上限。注意这直接决定 LLM 调用量与耗时：
# 实测单条 enrich 约 $0.15~0.26（CLI 记账值）、约 60s，1500 条 ≈ 4 小时。
# 第一次跑建议先设小值试水。
MAX_ITEMS_PER_RUN=50
# 单个源每轮最多贡献多少候选（0 = 不限流）。不限流时一个高产源
# （实测 openai 单 feed 1193 条）会吃光整轮预算，产出毫无多样性。
MAX_ITEMS_PER_SOURCE=60

# === enrich ===
ENRICH_AGENT_ENABLED=true
ENRICH_MAX_WORKERS=6
# ⚠️ 单条超时不要低于抓取型路由的实际耗时
ENRICH_ITEM_TIMEOUT_SECONDS=180
# 这是**单条**预算上限，不是整轮总量上限，拦不住整体花费
ENRICH_MAX_BUDGET_USD=50
ENRICH_MAX_RETRIES=1
ENRICH_RETRY_BACKOFF_SECONDS=30
# enrich 结果增量落库的批大小。一轮要跑几小时，不增量写的话中断就全丢。
# 0 = 关闭增量落库（回到“整轮结束才写一次”的旧行为）
ENRICH_FLUSH_EVERY=25
# 全文增量落库的批大小。全文抓取一轮 10~20 分钟，不增量写则中断全部重抓。
# 0 = 关闭
FULLTEXT_FLUSH_EVERY=50

# === global_sight 分批并发 ===
GLOBAL_AGENT_BATCH_SIZE=200
GLOBAL_AGENT_MAX_CONCURRENT=10
GLOBAL_AGENT_TIMEOUT_SECONDS=480

# === RSS 抓取 ===
# 自建服务，未部署时留空即可（对应的 [werss] 源会被 FEED_SECTIONS_DISABLE 停掉）
WERSS_BASE_URL=
# 私有 RSSHub 实例（含 bilibili video-browser 等 fork 路由），逗号分隔
RSSHUB_PRIVATE_INSTANCES=

# 超时：connect 短（死主机快速失败），read 必须宽松——
# /juejin/* 这类抓取型路由在健康实例上实测要 19~28s，调到 10s 会直接杀掉它们。
# 黑洞实例不靠 read timeout 治，靠下面的启动预检治。
FEED_CONNECT_TIMEOUT_SECONDS=3
FEED_READ_TIMEOUT_SECONDS=30

# ⚠️ 不要靠提高并发来"提速"：部分超时是我们自己的并发打在公共实例上造成的限流
# （rsshub.rssforever.com 单发探测 200/2.7s，跑批时却多次超时）
FEED_FETCH_CONCURRENCY=10
WERSS_FETCH_CONCURRENCY=50

# === 全文抓取（三级降级 trafilatura → playwright → 微信）===
# 各级预算由 ITEM_TIMEOUT 推导：L1=min(10,T//3)  L2=min(20,T//2)  L3=min(15,T//2)
# ⚠️ L2 硬封顶 20s，把 T 调到多大都不会给 L2 更多时间。
# 而 playwright 的内部耗时（launch ~2s + page.goto + render wait）必须显著小于
# 这个外层预算，否则外层会在它完成前砍掉。代码已自动钳制
# PLAYWRIGHT_NAVIGATION_TIMEOUT_S 到 L2 预算的一半，不需要手动调。
# （钳制前默认 nav=15 → 内部≈19s vs 外层 20s，余量为零，实测 22 次尝试 0 成功）
FULLTEXT_ITEM_TIMEOUT_S=60
# 每个 URL 都会 chromium.launch() 一次，10 并发 = 10 个浏览器同时起。
# 实测 10 → 5 后吞吐与成功率都显著上升（38 篇/分钟、98% 成功）。
FULLTEXT_MAX_WORKERS=5

# 实例熔断：基础冷却 × 2^(连续失败次数-1)，封顶 max
RSSHUB_FAILURE_COOLDOWN_SECONDS=900
RSSHUB_FAILURE_COOLDOWN_MAX_SECONDS=3600
# 单条路由最多试几个实例（0 = 不限制）。bilibili/twitter 的专用实例不受此限挤压
RSSHUB_MAX_CANDIDATES=5

# 抓取前并发探活所有实例，把死的预先打上冷却，消除冷启动惊群
# （没有预检时，N 个并发路由会一起撞向同一个坏实例，实测失败次数 ≈ 并发数）
RSSHUB_PREFLIGHT_ENABLED=true
RSSHUB_PREFLIGHT_TIMEOUT_SECONDS=5

# 停用结构性失效的源。token: twitter / bilibili / werss / default
# 这些源不是"暂时挂了靠熔断发现"，而是配置上就拿不到数据，每轮都轮一遍候选纯属烧时间。
# 修好对应服务后删掉 token 即可恢复，feeds.txt 不用改。
#   twitter   —— 需要 RSSHUB_TWITTER_INSTANCES 指向认证实例，公共 RSSHub 拿不到
#   bilibili  —— 需要私有 fork 实例（含 video-browser 路由）
#   werss     —— 需要 WERSS_BASE_URL 服务在线
FEED_SECTIONS_DISABLE=twitter,bilibili,werss

# feed 级熔断（与上面的实例级独立）
FEED_FAILURE_COOLDOWN_SECONDS=60
FEED_FAILURE_COOLDOWN_MAX_SECONDS=1800
FEED_CURSOR_LOOKBACK_HOURS=24

# === 关键词过滤（可选，逗号分隔，留空=不过滤）===
KEYWORDS_INCLUDE=
KEYWORDS_EXCLUDE=

# === 政策信源子系统（独立于主 RSS 链路，详见 README 第 10 节）===
# 以下均为默认值，不调可不写
POLICY_SOURCES_FILE=policy_sources.toml
POLICY_FETCH_CONCURRENCY=4
POLICY_CONNECT_TIMEOUT_SECONDS=5
POLICY_READ_TIMEOUT_SECONDS=20
# 连续空跑几次就当作疑似失效告警（政府站点更新频率低，2 次比较稳妥）
POLICY_STALE_EMPTY_RUNS=2

# 预筛（triage）：N 个标题打包一次 LLM 调用，筛出 AI 相关的再逐篇 deep enrich。
# 实测 442 篇里只有 12% 相关度≥3；不做预筛直接 enrich 约 $62，做了约 $10。
# batch 实测：10 条稳定；20 条偏激进（error_max_structured_output_retries）；50 条撞超时。
POLICY_TRIAGE_BATCH_SIZE=10
POLICY_TRIAGE_MAX_CONCURRENT=3
POLICY_TRIAGE_LIMIT=300
POLICY_TRIAGE_TIMEOUT_SECONDS=240
POLICY_TRIAGE_MAX_BUDGET_USD=2

# 深度抽取（enrich）
POLICY_ENRICH_MIN_RELEVANCE=3     # 只对预筛相关度 ≥ 此值的文档做 deep enrich（1=不设门槛）
POLICY_ENRICH_LIMIT=20            # 单次最多 enrich 多少篇
POLICY_ENRICH_MAX_WORKERS=4
POLICY_ENRICH_TIMEOUT_SECONDS=180
POLICY_ENRICH_MAX_BUDGET_USD=1    # 单篇预算，不是总量上限
POLICY_ENRICH_MAX_TEXT_CHARS=12000
POLICY_FULLTEXT_MAX_WORKERS=6

# === 路径覆盖（一般不用改）===
# FEEDS_FILE=feeds.txt
# RSSHUB_INSTANCES_FILE=rsshub_instances.txt
